<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<groupId>com.nikhitech</groupId>
	<artifactId>decision-logger</artifactId>
	<version>1.0.0</version>
	<packaging>war</packaging>

	<name>Decision Logger</name>
	<description>Spring MVC + Thymeleaf + JDBC Demo</description>

	<!-- ==========================
         Project Properties
         ========================== -->
	<properties>
		<java.version>1.8</java.version>
		<spring.version>5.3.30</spring.version>
		<thymeleaf.version>3.0.15.RELEASE</thymeleaf.version>
		<!-- You can add database driver version here if needed -->
		<dbcp.version>2.12.0</dbcp.version>
	</properties>

	<dependencies>

		<!-- ==========================
             Spring MVC Web framework
             Provides DispatcherServlet, Controllers, etc.
             ========================== -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-webmvc</artifactId>
			<version>${spring.version}</version>
		</dependency>

		<!-- ==========================
             Spring JDBC
             Provides JdbcTemplate and database support
             ========================== -->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-jdbc</artifactId>
			<version>${spring.version}</version>
		</dependency>

		<!-- ==========================
             Thymeleaf Template Engine
             Used for rendering views
             ========================== -->
		<dependency>
			<groupId>org.thymeleaf</groupId>
			<artifactId>thymeleaf-spring5</artifactId>
			<version>${thymeleaf.version}</version>
		</dependency>

		<!-- ==========================
             Servlet API
             Provided by Tomcat or other servlet container
             ========================== -->
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>javax.servlet-api</artifactId>
			<version>4.0.1</version>
			<scope>provided</scope>
		</dependency>

		<!-- ==========================
             Connection Pool (Recommended for JDBC)
             ========================== -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-dbcp2</artifactId>
			<version>${dbcp.version}</version>
		</dependency>

		<!-- ==========================
            Database Driver (PostgreSQL example)
             Uncomment and add version when using a database
             ========================== -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<version>42.7.3</version>
		</dependency>

		<!-- Hibernate Validator implementation of Bean Validation (JSR 380) -->
		<dependency>
			<groupId>org.hibernate.validator</groupId> <!-- Hibernate Validator
			group -->
			<artifactId>hibernate-validator</artifactId> <!-- Implementation of
			the validation framework -->
			<version>6.2.5.Final</version> <!-- Stable release compatible with
			Bean Validation 2.0 -->
		</dependency>

		<!-- Bean Validation API (JSR 380) specification -->
		<dependency>
			<groupId>javax.validation</groupId> <!-- Javax validation
			specification package -->
			<artifactId>validation-api</artifactId> <!-- Defines validation
			annotations like @NotNull, @Size -->
			<version>2.0.1.Final</version> <!-- Bean Validation 2.0 API version -->
		</dependency>
		
		<!-- Logging dependencies: SLF4J API with Logback implementation -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			 <version>1.7.36</version>
		</dependency>

		<!-- Logback provides the actual logging implementation -->
		<dependency>
			<groupId>ch.qos.logback</groupId>
			<artifactId>logback-classic</artifactId>
			<version>1.2.13</version>
		</dependency>


	</dependencies>

	<build>
		<finalName>decision-logger</finalName>
		<plugins>

			<!-- ==========================
                 Compiler Plugin
                 ========================== -->
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>${java.version}</source>
					<target>${java.version}</target>
				</configuration>
			</plugin>

			<!-- Optional: WAR Plugin if needed -->
			<plugin>
				<artifactId>maven-war-plugin</artifactId>
				<version>3.3.2</version>
				<configuration>
					<failOnMissingWebXml>false</failOnMissingWebXml>
				</configuration>
			</plugin>

		</plugins>
	</build>

</project>